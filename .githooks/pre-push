#!/bin/sh
# Mirrors the fmt/clippy gate that .github/workflows/ci.yml enforces, so a
# push that would fail CI fails locally in seconds instead of minutes on a
# GitHub-hosted runner. Enable once per clone:
#
#   git config core.hooksPath .githooks
#
# Skip for one push in an emergency: git push --no-verify

set -eu

echo "pre-push: cargo fmt --all --check"
if ! cargo fmt --all --check; then
    echo
    echo "pre-push: formatting check failed. Run 'cargo fmt --all' and re-commit." >&2
    exit 1
fi

echo "pre-push: cargo clippy --workspace --all-targets --locked -- -D warnings"
if ! cargo clippy --workspace --all-targets --locked -- -D warnings; then
    echo
    echo "pre-push: clippy failed. Fix the warnings above before pushing." >&2
    exit 1
fi

echo "pre-push: checks passed."
