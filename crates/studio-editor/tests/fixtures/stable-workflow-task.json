      "speaker_key": "speaker-2",
      "track_id": "track-speaker-2",
      "start_seconds": 67.39,
      "end_seconds": 67.7,
      "text": "Так.",
      "babel_original_annotation_id": "765940e5-12b9-5b29-97a2-5ace1d1261ef",
      "review_action_id": "e823c3bb-2697-55fc-9272-c083a55874da",
