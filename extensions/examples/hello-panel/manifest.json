{
  "id": "example.hello-panel",
  "name": "Hello Panel",
  "version": "0.1.0",
  "api": "^0.1.0",
  "runtime": "wasm",
  "description": "An offline panel and command that inserts a greeting as one undoable transaction, empty-segment hints, and a sample account provider with a mode that greets the signed-in name.",
  "license": "MIT",
  "dependencies": {},
  "permissions": [{ "kind": "document-read" }, { "kind": "document-edit" }, { "kind": "secrets" }],
  "providers": [{ "id": "example.hello.account", "name": "Hello account" }],
  "modes": [
    {
      "id": "example.hello.notes",
      "name": "Hello notes",
      "provider": "example.hello.account",
      "launch": "direct"
    }
  ]
}
